# Local settings for po2_transients.
#
# Copy this file to ".env" (same folder) and edit the values:
#     cp .env.example .env
# .env is listed in .gitignore, so your local paths are never uploaded to GitHub.
# Lines starting with # are comments. Leave a value empty to use the default.

# Folder that holds the session folders (e.g. 26-10-05_B6_318/pO2_all_synced_run05.mat).
# Default: the data/ folder inside this repo. Absolute paths and ~ work; relative paths are relative to the repo.
# Example (macOS): PO2_DATA_DIR=/Volumes/LabDrive/pO2/synced
# Example (Windows): PO2_DATA_DIR=Z:/pO2/synced
PO2_DATA_DIR=

# Folder where presentation_figures saves PNG/SVG files. Default: figures/ inside this repo.
PO2_FIG_DIR=
